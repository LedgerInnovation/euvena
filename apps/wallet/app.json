{
  "expo": {
    "name": "Euvena",
    "slug": "euvena",
    "version": "0.0.0",
    "scheme": "euvena",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ledgerinnovation.euvena"
    },
    "android": {
      "package": "com.ledgerinnovation.euvena",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to read payment QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-restored-launch-link",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EDF5FD",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "de", "fr", "es", "it", "nl", "pl"]
        }
      ]
    ]
  }
}

{
  "name": "@euvena/taler",
  "version": "0.1.3",
  "description": "Top up GNU Taler reserves with standard European payment QR codes (EPC069-12 / EN 18184)",
  "keywords": [
    "taler",
    "gnu-taler",
    "sepa",
    "sepa-instant",
    "qr",
    "girocode",
    "epc-qr",
    "payments",
    "withdrawal",
    "reserve"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LedgerInnovation/euvena.git",
    "directory": "packages/taler"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@euvena/qr": "workspace:^0.1.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
